# Sunucu Ayarları
PORT=5055
NODE_ENV=development

# Veritabanı
MONGO_URI=mongodb://localhost:27017/mes_db

# Güvenlik & Yetkilendirme
JWT_SECRET=super_secret_jwt_key_change_in_production

# Frontend Bağlantısı & CORS (Virgülle ayrılmış ek originler eklenebilir)
FRONTEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Makine Simülatörü WebSocket Adresi
SIMULATOR_WS_URL=ws://localhost:8765

# E-posta Servisi (İsteğe bağlı)
EMAIL_USER=
EMAIL_PASSWORD=
MAIL_FROM_NAME=
ADMIN_EMAIL=
SMTP_USER=
